{
  "name": "crown-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A mastery laboratory for the Fabricating Flow State project. Not a game.",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "vite",
    "dev:game": "vite --mode game",
    "dev:mobile": "vite --host 0.0.0.0",
    "dev:coop": "node scripts/dev-coop.mjs",
    "dev:coop:stun": "node scripts/dev-coop.mjs --stun=local",
    "stun:local": "node scripts/stun-local.mjs",
    "build": "npm run build:game",
    "build:game": "npm run check && npm run bundle:game",
    "build:lab": "npm run check && node scripts/build-watermarked-lab.mjs",
    "build:all": "npm run check && npm run bundle:game && node scripts/build-watermarked-lab.mjs --recipient security-gate",
    "bundle:game": "vite build --mode game --outDir dist && node scripts/verify-production-build.mjs --dir dist --profile game && node scripts/smoke-production-build.mjs --dir dist",
    "bundle:lab": "node scripts/build-watermarked-lab.mjs",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "build:termux": "npm run build:termux:game",
    "build:termux:game": "npm run build && node scripts/build-termux.mjs --dir dist --profile game",
    "build:termux:lab": "npm run check && node scripts/build-watermarked-lab.mjs --termux",
    "preview": "vite preview",
    "preview:mobile": "vite preview --mode game --host 0.0.0.0",
    "preview:lab": "vite preview --outDir dist-lab",
    "preview:lab:mobile": "vite preview --outDir dist-lab --host 0.0.0.0",
    "preview:coop": "node scripts/dev-coop.mjs --preview",
    "preview:coop:stun": "node scripts/dev-coop.mjs --preview --stun=local",
    "preview:coop:lab:stun": "node scripts/dev-coop.mjs --preview --lab --stun=local",
    "guard:commit": "npm run build:all",
    "hooks:install": "node scripts/install-hooks.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run verify:tooling && npm run rooms:check && npm run test",
    "mangle:report": "node scripts/mangle-allowlist.ts --why",
    "capture": "node scripts/capture-shots.mjs",
    "capture:models": "node scripts/capture-model-states.mjs",
    "compare:apotheosis": "node scripts/compare-apotheosis.mjs",
    "pilot": "node scripts/pilot-runs.mjs",
    "score:runs": "node scripts/score-runs.mjs",
    "watch:run": "node scripts/watch-run.mjs",
    "spectate": "node scripts/spectate-run.mjs",
    "measure:room-zoom": "node scripts/measure-room-zoom.mjs",
    "probe:phone": "node scripts/serve-phone-probe.mjs",
    "rooms:camera": "node scripts/emit-room-camera.mjs",
    "rooms:check": "node scripts/check-rooms.mjs",
    "rooms:calibrate": "node scripts/check-room-camera.mjs",
    "rooms:blockout": "node scripts/render-room-blockout.mjs",
    "rooms:arena": "node scripts/derive-room-arena.mjs",
    "rooms:panel": "node scripts/measure-panel-corners.mjs",
    "rooms:frame": "node scripts/check-room-frame.mjs",
    "rooms:reference": "node scripts/measure-reference-projection.mjs",
    "rooms:export": "node scripts/export-room-layers.mjs",
    "rooms:mesh": "node scripts/export-room-mesh.mjs",
    "rooms:open": "node scripts/open-room-blender.mjs",
    "rooms:blend": "node scripts/save-room-blend.mjs",
    "audit:touch": "node scripts/audit-touch-layout.mjs",
    "audit:ui": "node scripts/audit-ui-layout.mjs",
    "verify:tooling": "node scripts/verify-tooling.mjs",
    "verify:engines": "node scripts/verify-cross-engine.mjs",
    "soak:lockstep": "node scripts/soak-lockstep.mjs",
    "bench:sim": "node scripts/bench-sim.mjs",
    "bench:frame": "node scripts/bench-frame.mjs",
    "bench:frame:gate": "npm run bench:frame -- --viewports=mobile-landscape --cpu=6 --assert && npm run bench:frame -- --viewports=mobile-landscape --cpu=6 --live --assert",
    "props:probe": "node scripts/gen-room-meshy.mjs",
    "concept:plan": "node scripts/plan-concepts.mjs",
    "concept:ingest": "node scripts/process-concept.mjs",
    "concept:wire": "node scripts/process-concept.mjs --wire",
    "concept:check": "node scripts/check-concepts.mjs",
    "audio:plan": "node scripts/gen-audio.mjs --list",
    "audio:gen": "node scripts/gen-audio.mjs",
    "audio:check": "node scripts/check-audio.mjs",
    "audio:audition": "node scripts/audition-audio.mjs",
    "audio:bank": "node scripts/build-audio-bank.mjs",
    "audio:find": "node scripts/find-audio-candidates.mjs",
    "cast:rig": "node scripts/rig-cast-mesh.mjs",
    "cast:clips": "node scripts/author-cast-clips.mjs",
    "budget": "node scripts/budget.mjs",
    "cast:plan": "node scripts/gen-cast.mjs --plan",
    "cast:gen": "node scripts/gen-cast.mjs",
    "cast:mesh": "node scripts/export-cast-mesh.mjs",
    "cast:check": "node scripts/check-cast-glb.mjs",
    "cast:weights": "node scripts/weight-map-cast.mjs",
    "cast:rebind": "node scripts/rebind-cast-mesh.mjs",
    "cast:weapon": "node scripts/swap-cast-weapon.mjs",
    "cast:preview": "node scripts/preview-cast-mesh.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.4",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
